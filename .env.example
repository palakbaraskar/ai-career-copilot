# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL
# Example for local PostgreSQL: postgresql://postgres:your_password@localhost:5432/career_copilot_db
# (Fallback to SQLite sqlite:///career_copilot.db if PostgreSQL is not running locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_copilot_db

# Flask Secret Key for Session Encryption
SECRET_KEY=super-secret-key-change-in-production
